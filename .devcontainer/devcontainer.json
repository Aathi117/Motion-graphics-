{
  "name": "Remotion Video Studio",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "postAttachCommand": "npm install && npm run studio",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "KineMaster Style Docu Studio",
      "onAutoForward": "openBrowser"
    }
  }
}
